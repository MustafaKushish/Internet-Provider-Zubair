{
  // إعداد التطوير المحلي: مثل wrangler.jsonc لكن بدون Workers AI (يحتاج تسجيل دخول Cloudflare)
  "name": "sas-plus-zubair",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sas-plus-db"
      // database_id يُنشأ تلقائياً عند أول نشر (wrangler deploy)
    }
  ],
  "observability": { "enabled": true }
}
