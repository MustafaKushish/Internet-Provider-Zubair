{
  // Cloudflare Worker: يخدم واجهة المنظومة (dist) وواجهة المزامنة /api
  "name": "sas-plus-zubair",
  "main": "worker/index.ts",
  // Variablen, die im Cloudflare-Dashboard eingetragen wurden, bleiben bei jedem Deploy erhalten
  "keep_vars": true,
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sas-plus-db"
      // database_id يُنشأ تلقائياً عند أول نشر (wrangler deploy)
    }
  ],
  // Cloudflare Workers AI للمستشار الذكي (حصة يومية مجانية ضمن الحساب)
  "ai": { "binding": "AI" },
  "observability": { "enabled": true }
}
